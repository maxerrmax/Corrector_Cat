{
    "manifest_version": 3,
    "name": "Corrector Català",
    "version": "1.0",
    "description": "Detecta i suggereix correccions per a castellanismes i barbarismes habituals en català, mentre escrius.",

    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },

    "host_permissions": [
        "https://api.languagetool.org/*"
    ],

    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": [
                "dictionary.js",
                "suggestions.js",
                "overlay.js",
                "mirror.js",
                "languagetool.js",
                "content.js",
                "editable.js"
            ],
            "css": [
                "style.css"
            ]
        }
    ]
}